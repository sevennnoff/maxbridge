# Номер телефона аккаунта MAX в международном формате.
PHONE=

# Токен Telegram-бота от BotFather.
BOT_TOKEN=

# JSON-список чатов: [{ "max": <ID чата MAX>, "tg": <ID чата TG>, "tg2max": true/false }]
# tg2max: true — пересылать из TG в MAX, false — только из MAX в TG.
CHATS=[{"max": "-10000000000000", "tg": -1000000000000, "tg2max": false}]

# Optional MAX WebSocket endpoint override.
MAX_WS_URI=
