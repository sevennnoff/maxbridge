# Номер телефона аккаунта MAX в международном формате.
PHONE=

# Токен Telegram-бота от BotFather.
BOT_TOKEN=

# Глобальное включение пересылки из Telegram в MAX: true — для всех чатов, false — выключено глобально.
# Если false, пересылку из TG в MAX можно включить точечно через FORWARD_TG_TO_MAX_CHATS или в CHATS.
FORWARD_TG_TO_MAX=false

# Выборочное включение пересылки из Telegram в MAX для конкретных чатов (ID чатов TG или MAX через запятую или JSON-массив).
# Примеры:
# FORWARD_TG_TO_MAX_CHATS=[-1000000000000]
# FORWARD_TG_TO_MAX_CHATS=-1000000000000,-2000000000000
FORWARD_TG_TO_MAX_CHATS=

# JSON-словарь связей чатов: "id чата MAX" -> id чата Telegram.
# 1) Простой формат (число):
# CHATS={"-10000000000000": -1000000000000, "-20000000000000": -2000000000000}
#
# 2) Расширенный формат с индивидуальным флагом forward_tg_to_max:
# CHATS={"-10000000000000": {"tg_id": -1000000000000, "forward_tg_to_max": true}, "-20000000000000": -2000000000000}
CHATS={"-10000000000000": -1000000000000}
